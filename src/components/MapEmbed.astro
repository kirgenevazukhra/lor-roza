---
// Карта в блоке «Запись» — виджет 2ГИС с карточкой Lor.roza.
// Показывается сразу; loading="lazy" лишь откладывает загрузку, пока
// блок не приблизится к экрану, — первый экран от этого не тормозит.
// Координаты сверены по карточке Lor.roza в 2ГИС.
import { contacts } from '../lib/site.js';

const { lat, lon } = contacts.geo;
// id организации — из ссылки на карточку в 2ГИС
const org = contacts.dgis.split('/').pop();
const options = { pos: { lat, lon, zoom: 17 }, opt: { city: 'astana' }, org };
const src = `https://widgets.2gis.com/widget?type=firmsonmap&options=${encodeURIComponent(JSON.stringify(options))}`;
---

<div class="map">
  <iframe
    src={src}
    title="Карта 2ГИС: как добраться до кабинета"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
</div>

<style>
  .map{
    /* на телефоне выше: карточка 2ГИС занимает ~270px и закрыла бы метку */
    position:relative; aspect-ratio:4/5; margin:0 0 28px;
    border:1px solid rgba(244,239,231,.16); background:rgba(244,239,231,.04);
    overflow:hidden;
  }
  .map iframe{display:block; width:100%; height:100%; border:0}
  @media (min-width:900px){ .map{aspect-ratio:16/9} }
</style>
