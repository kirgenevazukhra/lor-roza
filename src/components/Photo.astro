---
// Одна фотография во всех ширинах: WebP через srcset, JPG запасным.
const {
  name,
  alt,
  sizes = '100vw',
  widths = [640, 1024, 1600, 2000],
  loading = 'lazy',
  fetchpriority,
  class: className = '',
} = Astro.props;

// base нужен, чтобы черновик работал на GitHub Pages по вложенному пути
// BASE_URL приходит без завершающего слеша — дописываем, иначе пути склеиваются
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const srcset = widths.map((w) => `${base}images/${name}-${w}.webp ${w}w`).join(', ');
---
<img
  src={`${base}images/${name}-1024.jpg`}
  srcset={srcset}
  sizes={sizes}
  alt={alt}
  class={className}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding="async"
/>

<style>
  /* Стиль живёт здесь: Astro скоупит по компоненту, и правило из страницы
     до этой картинки не дотянулось бы. */
  img{
    display:block;
    width:100%;
    height:100%;
    object-fit:cover;
    background:rgba(35,30,25,.06);
  }
</style>
