---
import Topbar from '../components/Topbar.astro';
import { contacts } from '../lib/site.js';
import '../styles/tokens.css';

const { title, description, series, date, video } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}og.jpg`, Astro.site).href;

const dateLabel = date
  ? new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }).format(date)
  : null;
---

<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title} — Lor.roza</title>
<meta name="description" content={description} />
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
<link rel="icon" href={`${base}favicon.png`} sizes="32x32" />
<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
<meta name="theme-color" content="#F4EFE7" />
<!-- Черновик на согласовании: в поиск не отдаём до запуска на своём домене. -->
<meta name="robots" content="noindex, nofollow" />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="article" />
<meta property="og:site_name" content="Lor.roza" />
<meta property="og:locale" content="ru_RU" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Oranienbaum&family=Onest:wght@300;400;500;600&display=swap" rel="stylesheet" />
<style is:inline set:html={`:root{--paper-url:url('${base}images/textures/paper.webp')}`}></style>
</head>
<body>

<a class="skip" href="#article">К тексту статьи</a>

<Topbar />

<main id="article">
  <article class="wrap">
    <header class="head">
      <p class="kicker">{series}</p>
      <h1>{title}</h1>
      {description && <p class="lede">{description}</p>}
      <p class="byline">
        <span>{contacts.doctorName}</span>
        {dateLabel && <em>{dateLabel}</em>}
      </p>
    </header>

    {video && (
      <figure class="clip">
        <video
          controls
          preload="none"
          playsinline
          poster={`${base}video/${video.poster}`}
          width="720"
          height="1280"
        >
          <source src={`${base}video/${video.src}`} type="video/mp4" />
          Ваш браузер не воспроизводит видео. Ролик есть в Instagram врача.
        </video>
        {video.caption && <figcaption>{video.caption}</figcaption>}
      </figure>
    )}

    <div class="body">
      <slot />
    </div>

    <footer class="tail" data-section="article">
      <p class="disclaimer">
        Материал носит справочный характер и не заменяет очную консультацию.
        План лечения подбирается на приёме.
      </p>
      <div class="actions">
        <a class="btn btn-solid" href={contacts.whatsappBooking}>Записаться на приём</a>
        <a class="btn btn-line" href={`${base}#guides`}>Все статьи</a>
      </div>
    </footer>
  </article>
</main>

<footer class="foot">
  <p>{contacts.doctorName} · {contacts.specialty} · {contacts.city}</p>
  <p>Часы работы: {contacts.hours}</p>
  <p class="muted">Информация на сайте не заменяет очную консультацию.</p>
  <p class="muted">Политика конфиденциальности: {contacts.privacy}</p>
</footer>

<a class="sticky-wa" href={contacts.whatsapp} data-section="sticky">Написать в WhatsApp</a>

<style>
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%; scroll-behavior:smooth}
body{
  margin:0; color:var(--ink);
  background-color:var(--cream);
  background-image:var(--paper-url);
  background-size:420px auto;
  background-blend-mode:multiply;
  font-family:var(--sans); font-size:17px; line-height:1.6; font-weight:300;
  padding-bottom:88px;
}
a{color:inherit}
.skip{position:absolute; left:-9999px; top:0; z-index:100; background:var(--gold); color:#fff; padding:12px 18px}
.skip:focus{left:0}
a:focus-visible{outline:2px solid var(--gold); outline-offset:3px}

.wrap{max-width:680px; margin:0 auto; padding:40px var(--gut) 20px}

/* ── шапка статьи ───────────────────────────────── */
.kicker{
  margin:0 0 14px; font-size:12px; letter-spacing:.22em;
  text-transform:uppercase; color:var(--gold); font-weight:500;
}
h1{
  font-family:var(--display); font-weight:400;
  font-size:clamp(32px,7.4vw,48px); line-height:1.08; letter-spacing:.005em;
  margin:0 0 20px;
}
.lede{font-size:19px; color:var(--ink-soft); margin:0 0 24px}
.byline{
  display:flex; flex-wrap:wrap; align-items:baseline; gap:6px 14px;
  margin:0 0 36px; padding-bottom:22px; border-bottom:1px solid var(--line);
  font-size:13px; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-soft);
}
.byline em{font-style:normal; color:var(--gold)}

/* ── ролик ──────────────────────────────────────── */
/* Вертикальный кадр 9:16: во всю ширину колонки он подавил бы текст,
   поэтому на десктопе ограничен. preload="none" — ничего не грузится,
   пока не нажали: на мобильном это экономит мегабайты. */
.clip{margin:0 0 40px}
.clip video{
  display:block; width:100%; height:auto; max-width:330px; margin:0 auto;
  aspect-ratio:9/16; object-fit:cover; background:var(--dark);
  border:1px solid var(--line);
}
.clip figcaption{
  margin:14px auto 0; max-width:330px;
  font-size:13px; letter-spacing:.02em; color:var(--ink-soft); text-align:center;
}

/* ── текст ──────────────────────────────────────── */
.body :global(p){margin:0 0 20px; font-size:17px; line-height:1.68}
.body :global(h2){
  font-family:var(--display); font-weight:400;
  font-size:clamp(25px,5.4vw,32px); line-height:1.16;
  margin:44px 0 16px; letter-spacing:.005em;
}
.body :global(h3){
  font-size:13px; letter-spacing:.18em; text-transform:uppercase;
  color:var(--gold); font-weight:500; margin:34px 0 14px;
}
.body :global(ul),
.body :global(ol){margin:0 0 22px; padding-left:0; list-style:none}
.body :global(li){
  position:relative; padding:0 0 12px 30px; font-size:17px; line-height:1.62;
}
.body :global(ul li)::before{
  content:''; position:absolute; left:2px; top:13px;
  width:12px; height:1px; background:var(--gold);
}
.body :global(ol){counter-reset:step}
.body :global(ol li){counter-increment:step}
.body :global(ol li)::before{
  content:counter(step); position:absolute; left:0; top:1px;
  font-size:13px; color:var(--gold); letter-spacing:.06em;
}
.body :global(strong){font-weight:500}
.body :global(a){color:var(--gold); text-underline-offset:3px}

/* ── подвал статьи ──────────────────────────────── */
.tail{margin-top:52px; padding-top:28px; border-top:1px solid var(--line)}
.disclaimer{margin:0 0 26px; font-size:14px; font-style:italic; color:var(--ink-soft)}
.actions{display:flex; flex-direction:column; gap:11px}
.btn{
  display:flex; align-items:center; justify-content:center;
  min-height:56px; padding:0 26px; text-decoration:none;
  font-size:13px; letter-spacing:.17em; text-transform:uppercase; font-weight:500;
}
.btn-solid{background:var(--dark); color:var(--cream)}
.btn-line{background:transparent; color:var(--ink); box-shadow:inset 0 0 0 1px rgba(35,30,25,.3)}

.foot{
  background:var(--darker); color:#9A8D7E;
  padding:28px var(--gut) 36px; font-size:13px; margin-top:60px;
}
.foot p{margin:0 0 5px; max-width:680px; margin-left:auto; margin-right:auto}
.muted{color:#7E7263}

.sticky-wa{
  position:fixed; left:14px; right:14px; bottom:14px; z-index:30;
  display:flex; align-items:center; justify-content:center;
  min-height:56px; background:var(--dark); color:var(--cream); text-decoration:none;
  font-size:13px; letter-spacing:.17em; text-transform:uppercase; font-weight:500;
  box-shadow:0 10px 30px rgba(25,20,17,.28);
}

@media (min-width:900px){
  body{font-size:18px; padding-bottom:0}
  .wrap{padding:64px var(--gut) 20px}
  .clip video{max-width:340px}
  .actions{flex-direction:row}
  .btn{flex:0 0 auto; min-width:250px}
  .sticky-wa{display:none}
}
@media (prefers-reduced-motion:reduce){ html{scroll-behavior:auto} }
</style>
<script>
  import '../scripts/analytics.js';
</script>
</body>
</html>
