---
import { contacts, services, guides, reviews, faq, prices, byGroup, hero, about } from '../../lib/site.js';

// Только подтверждённые факты — никакой выдуманной статистики.
const facts = [
  { v: '0+', l: 'принимаю с рождения' },
  { v: '2020', l: 'практикую с' },
  { v: '30 мин', l: 'первичный приём' },
  { v: '5', l: 'основных направлений' },
];
---

<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{contacts.doctorName} — ЛОР-врач в Астане · Вариант D</title>
<meta name="description" content={hero.subtitle} />
<meta name="robots" content="noindex" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Onest:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>

<div class="shell">

<!-- ПЕРВЫЙ ЭКРАН: пастельное поле, снимок врача вырезкой -->
<header class="hero">
  <nav class="nav">
    <span class="brand">Lor<span class="dot">.</span>roza</span>
    <a class="pill pill-call" href={contacts.phoneHref}>{contacts.phoneDisplay}</a>
  </nav>

  <p class="eyebrow">Астана · оториноларингология</p>
  <h1>{hero.title}</h1>
  <p class="sub">{hero.subtitle}</p>

  <div class="cutout">
    <div class="cutout-img">
      <span class="ph-mark">фото врача</span>
      <span class="ph-path">doctor/portrait.jpg</span>
      <span class="ph-hint">вертикальный портрет, лучше без фона</span>
    </div>
    <div class="cutout-chip">
      <span class="chip-dot"></span>
      <span>{contacts.doctorShort}<br /><em>ЛОР-врач</em></span>
    </div>
  </div>

  <div class="actions">
    <a class="btn btn-primary" href={contacts.whatsapp}>Написать в WhatsApp</a>
    <a class="btn btn-glass" href={contacts.whatsappBooking}>Записаться на приём</a>
  </div>
  <p class="micro">{hero.line}</p>
</header>

<!-- ЛЕНТА ФАКТОВ -->
<section class="facts">
  {facts.map((f) => (
    <div class="fact">
      <span class="fact-v">{f.v}</span>
      <span class="fact-l">{f.l}</span>
    </div>
  ))}
</section>

<!-- BENTO: почему выбирают -->
<section class="sec" id="why">
  <h2 class="sec-title">Почему выбирают</h2>
  <div class="bento">
    {services.whyMe.map((w, i) => (
      <article class={i === 0 ? 'tile tile-lead' : 'tile'}>
        <span class="tile-orb"></span>
        <h3>{w.title}</h3>
        <p>{w.text}</p>
      </article>
    ))}
  </div>
</section>

<!-- С ЧЕМ ОБРАЩАЮТСЯ -->
<section class="sec" id="complaints">
  <h2 class="sec-title">С чем обращаются</h2>
  <div class="bento">
    {services.complaints.map((c) => (
      <article class="tile">
        <span class="pill pill-tag">{c.region}</span>
        <h3>{c.title}</h3>
        <p>{c.note}</p>
      </article>
    ))}
  </div>
</section>

<!-- О ВРАЧЕ -->
<section class="sec" id="about">
  <h2 class="sec-title">О враче</h2>
  <div class="tile tile-wide">
    <p class="prose">{about}</p>
    <p class="sub-title">Что входит в консультацию</p>
    <ul class="checks">
      {services.consultationIncludes.map((s) => <li>{s}</li>)}
    </ul>
  </div>
</section>

<!-- ЦЕНЫ -->
<section class="sec" id="prices">
  <h2 class="sec-title">Услуги и цены</h2>
  <div class="tile tile-wide">
    <p class="sub-title">Приём</p>
    {byGroup('приём').map((p) => (
      <div class="prow">
        <span class="pname">{p.title}{p.meta && <em>{p.meta}</em>}</span>
        <span class="pval">{p.amount}&thinsp;{p.currency}</span>
      </div>
    ))}
    <p class="sub-title mt">Манипуляции</p>
    {byGroup('манипуляции').map((p) => (
      <div class="prow">
        <span class="pname">{p.title}{p.meta && <em>{p.meta}</em>}</span>
        <span class="pval">{p.amount}&thinsp;{p.currency}</span>
      </div>
    ))}
    <p class="micro dark">{prices.note}</p>
  </div>
</section>

<!-- КАК ПРОХОДИТ ПРИЁМ -->
<section class="sec" id="visit">
  <h2 class="sec-title">Как проходит приём</h2>
  <div class="bento">
    <article class="tile tile-wide">
      <p class="prose">Приём длится до тридцати минут. Осмотр уха, носа и горла, при необходимости — эндоскопия. Дальше разбираем, что происходит, и составляем план: что делать, чем лечить и зачем нужен каждый пункт.</p>
    </article>
    <article class="tile tile-soft">
      <h3>Если приём у ребёнка</h3>
      <p>Ребёнок плачет на осмотре чаще не от боли, а от страха. Осмотр идёт в темпе ребёнка: сначала знакомство с инструментом, потом сам осмотр. Годовалый может перенести его спокойно, а десятилетний — испугаться, и это тоже нормально.</p>
    </article>
    <article class="tile tile-photo">
      <span class="ph-mark">кабинет</span>
      <span class="ph-path">office/room.jpg</span>
    </article>
    <article class="tile tile-photo">
      <span class="ph-mark">оборудование</span>
      <span class="ph-path">office/endoscope.jpg</span>
    </article>
  </div>
</section>

<!-- ОТЗЫВЫ -->
<section class="sec" id="reviews">
  <h2 class="sec-title">Отзывы</h2>
  {reviews.pending && <p class="pending-flag">Образцы разметки. Настоящие отзывы переносятся из 2ГИС вручную.</p>}
  <div class="bento">
    {reviews.items.map((r) => (
      <blockquote class="tile tile-quote">
        {r.sample && <span class="sample-tag">образец</span>}
        <p>{r.text}</p>
        <cite>{r.name}</cite>
      </blockquote>
    ))}
  </div>
  <a class="link-out" href={contacts.dgis}>Все отзывы в 2ГИС →</a>
</section>

<!-- МАТЕРИАЛЫ -->
<section class="sec" id="guides">
  <h2 class="sec-title">Полезные материалы</h2>
  <p class="sec-note">Готовятся к публикации. Выходят после проверки врачом.</p>
  <div class="bento">
    {guides.series.map((s) => (
      <article class="tile">
        <h3>{s.title}</h3>
        <ul class="topics">{s.topics.map((t) => <li>{t}</li>)}</ul>
      </article>
    ))}
  </div>
</section>

<!-- FAQ -->
<section class="sec" id="faq">
  <h2 class="sec-title">Частые вопросы</h2>
  <div class="faq">
    {faq.items.map((f) => (
      <details>
        <summary><span>{f.q}</span></summary>
        {f.a && <p>{f.a}</p>}
        {f.pendingNote && <p class="pending-inline">{f.pendingNote}</p>}
      </details>
    ))}
  </div>
</section>

<!-- КОНТАКТЫ -->
<section class="sec" id="contacts">
  <h2 class="sec-title">Контакты</h2>
  <div class="tile tile-wide tile-contact">
    <dl class="contacts">
      <dt>Адрес</dt><dd>{contacts.address}<br /><span class="muted">{contacts.city}</span></dd>
      <dt>Запись</dt><dd>{contacts.scheduleNote}</dd>
      <dt>Телефон</dt><dd><a href={contacts.phoneHref}>{contacts.phoneDisplay}</a></dd>
      <dt>Instagram</dt><dd><a href={contacts.instagram}>{contacts.instagramHandle}</a></dd>
    </dl>
    <div class="actions">
      <a class="btn btn-primary" href={contacts.whatsappBooking}>Записаться на приём</a>
      <a class="btn btn-outline" href={contacts.dgis}>Открыть в 2ГИС</a>
    </div>
  </div>
</section>

<footer class="foot">
  <p>{contacts.doctorName} · {contacts.specialty} · {contacts.city}</p>
  <p class="muted">Информация на сайте не заменяет очную консультацию.</p>
</footer>

</div>

<a class="sticky-wa" href={contacts.whatsapp}>Написать в WhatsApp</a>

<style>
:root{
  --lilac:#EAE4F7;
  --blush:#FBE6EC;
  --sky:#E2EDF8;
  --mint:#E4F2EC;
  --ink:#241F33;
  --ink-soft:#6B6480;
  --accent:#7C6BD6;
  --accent-dk:#5F4FC0;
  --white:#fff;
  --sans:'Onest', system-ui, -apple-system, sans-serif;
  --gut:18px;
  --maxw:640px;
  --r:24px;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  margin:0; color:var(--ink);
  font-family:var(--sans); font-size:17px; line-height:1.55;
  padding:0 0 88px; overflow-x:hidden;
  background:
    radial-gradient(90% 55% at 12% 0%, var(--lilac) 0%, transparent 60%),
    radial-gradient(85% 50% at 92% 12%, var(--blush) 0%, transparent 58%),
    radial-gradient(80% 45% at 50% 42%, var(--sky) 0%, transparent 55%),
    radial-gradient(70% 40% at 8% 78%, var(--mint) 0%, transparent 55%),
    #F6F4FB;
  background-attachment:fixed;
}
a{color:inherit}
.shell{max-width:var(--maxw); margin:0 auto; padding:0 var(--gut)}

/* ── стеклянные пилюли ──────────────────────────── */
.pill{
  display:inline-flex; align-items:center; gap:7px;
  padding:9px 15px; border-radius:999px;
  background:rgba(255,255,255,.62);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.9), 0 2px 10px rgba(60,40,110,.07);
  backdrop-filter:blur(10px);
  font-size:14px; font-weight:500; text-decoration:none; white-space:nowrap;
}
.pill-call{min-height:44px}
.pill-tag{font-size:13px; padding:6px 13px; color:var(--accent-dk); margin:0 0 11px}

/* ── первый экран ───────────────────────────────── */
.nav{display:flex; align-items:center; justify-content:space-between; padding:16px 0 26px}
.brand{font-size:19px; font-weight:600; letter-spacing:-.02em}
.brand .dot{color:var(--accent)}
.eyebrow{
  margin:0 0 14px; font-size:13px; font-weight:500;
  letter-spacing:.11em; text-transform:uppercase; color:var(--ink-soft);
}
h1{
  font-size:clamp(36px,9.6vw,58px); line-height:1.02; font-weight:300;
  letter-spacing:-.035em; margin:0 0 16px;
}
.hero .sub{
  font-size:clamp(17px,4.3vw,20px); font-weight:300; color:var(--ink-soft);
  margin:0 0 20px; max-width:30ch;
}

/* снимок врача вырезкой на градиенте */
.cutout{position:relative; margin:0 0 20px}
.cutout-img{
  aspect-ratio:1; width:100%; border-radius:28px;
  background:
    linear-gradient(150deg, rgba(255,255,255,.75) 0%, rgba(255,255,255,.28) 100%);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.9), 0 16px 44px rgba(70,45,130,.1);
  backdrop-filter:blur(6px);
  display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px;
  text-align:center; padding:18px;
}
.ph-mark{font-size:13px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:var(--accent-dk)}
.ph-path{font-size:13px; color:var(--ink-soft)}
.ph-hint{font-size:13px; color:var(--ink-soft); opacity:.8; font-style:italic}
.cutout-chip{
  position:absolute; left:14px; bottom:14px;
  display:flex; align-items:center; gap:9px;
  padding:11px 16px; border-radius:999px;
  background:rgba(255,255,255,.82);
  box-shadow:0 6px 22px rgba(60,40,110,.13);
  backdrop-filter:blur(12px);
  font-size:14px; font-weight:600; line-height:1.35;
}
.cutout-chip em{font-style:normal; font-weight:400; color:var(--ink-soft); font-size:13px}
.chip-dot{
  width:9px; height:9px; border-radius:50%; flex:0 0 auto;
  background:linear-gradient(140deg,#8FD6B4,#4FB98A);
}

/* ── действия ───────────────────────────────────── */
.actions{display:flex; flex-direction:column; gap:10px; margin:0 0 14px}
.btn{
  display:flex; align-items:center; justify-content:center;
  min-height:54px; padding:0 22px; border-radius:999px;
  text-decoration:none; font-size:16px; font-weight:500;
}
.btn-primary{background:var(--ink); color:#fff}
.btn-glass{
  background:rgba(255,255,255,.6); color:var(--ink);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.95), 0 2px 12px rgba(60,40,110,.07);
  backdrop-filter:blur(10px);
}
.btn-outline{background:transparent; color:var(--ink); box-shadow:inset 0 0 0 1px rgba(36,31,51,.22)}
a:focus-visible,summary:focus-visible{outline:2px solid var(--accent); outline-offset:3px}
.micro{margin:0; font-size:14px; color:var(--ink-soft)}
.micro.dark{margin-top:16px}

/* ── лента фактов ───────────────────────────────── */
.facts{
  display:grid; grid-template-columns:1fr 1fr; gap:10px;
  margin:34px 0 8px;
}
.fact{
  border-radius:18px; padding:16px 14px;
  background:rgba(255,255,255,.55);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.9);
  backdrop-filter:blur(8px);
}
.fact-v{display:block; font-size:26px; font-weight:400; letter-spacing:-.02em; line-height:1.1}
.fact-l{display:block; font-size:13px; color:var(--ink-soft); margin-top:4px}

/* ── секции и bento ─────────────────────────────── */
.sec{padding:36px 0 8px}
.sec-title{
  font-size:13px; font-weight:600; letter-spacing:.13em; text-transform:uppercase;
  color:var(--ink-soft); margin:0 0 18px;
}
.sec-note{margin:-10px 0 18px; font-size:15px; color:var(--ink-soft)}
.sub-title{font-size:14px; font-weight:600; color:var(--ink-soft); margin:0 0 12px}
.sub-title.mt{margin-top:26px}
.prose{font-size:17px; line-height:1.62; margin:0 0 20px}

.bento{display:grid; grid-template-columns:1fr; gap:10px}
.tile{
  border-radius:var(--r); padding:22px 20px;
  background:rgba(255,255,255,.72);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.95), 0 4px 20px rgba(60,40,110,.06);
  backdrop-filter:blur(10px);
  margin:0;
}
.tile h3{font-size:19px; font-weight:500; margin:0 0 7px; letter-spacing:-.015em}
.tile p{margin:0; font-size:15px; color:var(--ink-soft)}
.tile-lead{background:linear-gradient(155deg, rgba(255,255,255,.9), rgba(234,228,247,.75))}
.tile-soft{background:linear-gradient(155deg, rgba(251,230,236,.8), rgba(255,255,255,.72))}
.tile-orb{
  display:block; width:34px; height:34px; border-radius:50%; margin:0 0 14px;
  background:conic-gradient(from 210deg, #C9B9F2, #F3C2D1, #BEDCF3, #C9B9F2);
  box-shadow:0 3px 12px rgba(90,60,160,.16);
}
.tile-photo{
  aspect-ratio:1; display:flex; flex-direction:column;
  align-items:center; justify-content:center; gap:5px; text-align:center;
}
.tile-contact .actions{margin-top:20px; margin-bottom:0}

.checks{list-style:none; margin:0; padding:0; display:grid; gap:8px}
.checks li{position:relative; padding-left:24px; font-size:15px; color:var(--ink-soft)}
.checks li::before{
  content:''; position:absolute; left:0; top:7px; width:8px; height:8px; border-radius:50%;
  background:var(--accent); opacity:.45;
}

/* ── цены ───────────────────────────────────────── */
.prow{
  display:flex; align-items:baseline; justify-content:space-between; gap:14px;
  padding:12px 0; border-bottom:1px solid rgba(36,31,51,.08);
}
.prow:last-of-type{border-bottom:0}
.pname{font-size:16px; display:flex; flex-direction:column}
.pname em{font-style:normal; font-size:13px; color:var(--ink-soft); margin-top:2px}
.pval{font-size:19px; font-weight:500; white-space:nowrap; font-variant-numeric:tabular-nums}

/* ── отзывы ─────────────────────────────────────── */
.pending-flag{
  margin:-8px 0 18px; padding:11px 14px; border-radius:16px; font-size:14px;
  background:rgba(255,255,255,.6); color:var(--accent-dk);
  box-shadow:inset 0 0 0 1px rgba(124,107,214,.25);
}
.tile-quote p{font-size:16px; color:var(--ink); margin:0 0 10px}
.tile-quote cite{font-style:normal; font-size:14px; font-weight:500; color:var(--ink-soft)}
.sample-tag{
  display:inline-block; font-size:11px; font-weight:600; letter-spacing:.12em;
  text-transform:uppercase; color:var(--accent-dk); margin:0 0 9px;
}
.link-out{
  display:inline-flex; align-items:center; min-height:44px; margin-top:6px;
  font-size:15px; font-weight:500; color:var(--accent-dk); text-decoration:none;
}

/* ── материалы / faq ────────────────────────────── */
.topics{list-style:none; margin:10px 0 0; padding:0}
.topics li{padding:9px 0; border-bottom:1px solid rgba(36,31,51,.07); font-size:15px; color:var(--ink-soft)}
.topics li:last-child{border-bottom:0}
.faq details{
  border-radius:18px; margin:0 0 9px; overflow:hidden;
  background:rgba(255,255,255,.68);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.95);
  backdrop-filter:blur(8px);
}
.faq summary{
  cursor:pointer; padding:16px 18px; font-size:16px; font-weight:500; list-style:none;
  display:flex; align-items:flex-start; gap:12px; min-height:44px;
}
.faq summary::-webkit-details-marker{display:none}
.faq summary::before{content:'+'; color:var(--accent); font-weight:500; flex:0 0 auto}
.faq details[open] summary::before{content:'–'}
.faq p{margin:0 0 16px; padding:0 18px 0 42px; font-size:15px; color:var(--ink-soft)}
.pending-inline{font-style:italic; color:var(--accent-dk)}

/* ── контакты / подвал ──────────────────────────── */
.contacts{margin:0; display:grid; grid-template-columns:auto 1fr; gap:12px 18px}
.contacts dt{font-size:13px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:var(--ink-soft); padding-top:4px}
.contacts dd{margin:0; font-size:16px}
.contacts dd a{display:inline-flex; align-items:center; min-height:44px}
.muted{color:var(--ink-soft)}
.foot{padding:30px 0 36px; font-size:14px; color:var(--ink-soft)}
.foot p{margin:0 0 5px}

/* ── закреплённая кнопка ────────────────────────── */
.sticky-wa{
  position:fixed; left:14px; right:14px; bottom:14px; z-index:30;
  display:flex; align-items:center; justify-content:center;
  min-height:56px; border-radius:999px; background:var(--ink); color:#fff;
  text-decoration:none; font-size:16px; font-weight:500;
  box-shadow:0 10px 30px rgba(36,31,51,.3);
}

/* ── десктоп ────────────────────────────────────── */
@media (min-width:768px){
  :root{--gut:32px; --maxw:1060px}
  body{font-size:18px; padding-bottom:0}
  .nav{padding:26px 0 44px}
  h1{font-size:clamp(52px,6vw,76px); max-width:17ch}
  .hero{position:relative}
  .hero .sub{font-size:21px; max-width:34ch}
  .cutout{max-width:460px}
  .cutout-img{aspect-ratio:16/10}
  .actions{flex-direction:row}
  .btn{flex:0 0 auto; min-width:250px}
  .facts{grid-template-columns:repeat(4,1fr); gap:12px}
  .fact-v{font-size:32px}
  .sec{padding:56px 0 8px}
  .bento{grid-template-columns:repeat(2,1fr); gap:12px}
  .tile-lead,.tile-wide{grid-column:1 / -1}
  .tile-photo{aspect-ratio:4/3}
  .checks{grid-template-columns:1fr 1fr; gap:9px 26px}
  .sticky-wa{display:none}
}
@media (prefers-reduced-motion:no-preference){
  .btn,.tile,.link-out{transition:transform .18s ease, box-shadow .18s ease}
  .btn:hover{transform:translateY(-2px)}
  .tile:hover{transform:translateY(-2px); box-shadow:inset 0 0 0 1px rgba(255,255,255,.95), 0 10px 30px rgba(60,40,110,.1)}
}
</style>
</body>
</html>
