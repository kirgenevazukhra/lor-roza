---
import { contacts, services, guides, reviews, faq, prices, byGroup, hero, about } from '../../lib/site.js';
---

<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{contacts.doctorName} — ЛОР-врач в Астане · Вариант E</title>
<meta name="description" content={hero.subtitle} />
<meta name="robots" content="noindex" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>

<!-- ПЕРВЫЙ ЭКРАН: снимок под синей заливкой -->
<header class="hero">
  <nav class="nav">
    <span class="brand">Lor<span class="dot">.</span>roza</span>
    <a class="nav-call" href={contacts.phoneHref}>{contacts.phoneDisplay}</a>
  </nav>

  <div class="hero-body">
    <p class="eyebrow">ЛОР-кабинет · Астана</p>
    <h1>{hero.title}</h1>
    <p class="sub">{hero.subtitle}</p>

    <div class="actions">
      <a class="btn btn-primary" href={contacts.whatsappBooking}>Записаться на приём</a>
      <a class="btn btn-ghost" href={contacts.phoneHref}>
        <span class="call-ico"></span>
        <span class="call-txt">Позвонить<em>{contacts.phoneDisplay}</em></span>
      </a>
    </div>
  </div>

  <div class="hero-photo">
    <span class="ph-mark">фото врача</span>
    <span class="ph-path">doctor/portrait.jpg</span>
    <span class="ph-hint">вертикальный портрет</span>
  </div>

  <!-- карточка приёма вместо «часов работы»: расписание не публикуем -->
  <div class="hours-card">
    <h2>Приём</h2>
    <div class="hrow"><span>Запись</span><b>через WhatsApp</b></div>
    <div class="hrow"><span>Формат</span><b>очно и онлайн</b></div>
    <div class="hrow"><span>Возраст</span><b>с рождения</b></div>
    <p class="hours-note">{contacts.scheduleNote}</p>
  </div>
</header>

<!-- О ВРАЧЕ -->
<section class="sec" id="about">
  <p class="kicker">О враче</p>
  <h2 class="sec-h">Доказательный подход, без лишних назначений</h2>
  <p class="prose">{about}</p>
  <div class="stat-row">
    <div class="stat stat-dark"><b>с 2020</b><span>практикую</span></div>
    <div class="stat"><b>0+</b><span>принимаю с рождения</span></div>
    <div class="stat"><b>30 мин</b><span>первичный приём</span></div>
  </div>
  <p class="line">{hero.line}</p>
</section>

<!-- ПОЧЕМУ ВЫБИРАЮТ -->
<section class="sec tint" id="why">
  <p class="kicker center">Почему выбирают</p>
  <h2 class="sec-h center">Что вы получите на приёме</h2>
  <div class="grid">
    {services.whyMe.map((w) => (
      <article class="card">
        <span class="card-ico"></span>
        <h3>{w.title}</h3>
        <p>{w.text}</p>
      </article>
    ))}
  </div>
</section>

<!-- С ЧЕМ ОБРАЩАЮТСЯ -->
<section class="sec" id="complaints">
  <p class="kicker center">Направления</p>
  <h2 class="sec-h center">С чем обращаются</h2>
  <div class="grid">
    {services.complaints.map((c) => (
      <article class="card card-photo">
        <div class="card-band"><span class="band-tag">{c.region}</span></div>
        <h3>{c.title}</h3>
        <p>{c.note}</p>
      </article>
    ))}
  </div>
</section>

<!-- ЧТО ВХОДИТ -->
<section class="sec tint" id="services">
  <p class="kicker">Консультация</p>
  <h2 class="sec-h">Что входит в приём</h2>
  <ul class="checks">
    {services.consultationIncludes.map((s) => <li>{s}</li>)}
  </ul>
</section>

<!-- ЦЕНЫ -->
<section class="sec" id="prices">
  <p class="kicker center">Прайс</p>
  <h2 class="sec-h center">Услуги и цены</h2>
  <div class="price-card">
    <p class="price-head">Приём</p>
    {byGroup('приём').map((p) => (
      <div class="prow">
        <span class="pname">{p.title}{p.meta && <em>{p.meta}</em>}</span>
        <span class="pval">{p.amount}&thinsp;{p.currency}</span>
      </div>
    ))}
    <p class="price-head mt">Манипуляции</p>
    {byGroup('манипуляции').map((p) => (
      <div class="prow">
        <span class="pname">{p.title}{p.meta && <em>{p.meta}</em>}</span>
        <span class="pval">{p.amount}&thinsp;{p.currency}</span>
      </div>
    ))}
    <p class="micro">{prices.note}</p>
    <a class="btn btn-primary full" href={contacts.whatsappBooking}>Записаться на приём</a>
  </div>
</section>

<!-- КАК ПРОХОДИТ ПРИЁМ -->
<section class="sec tint" id="visit">
  <p class="kicker">Приём</p>
  <h2 class="sec-h">Как проходит приём</h2>
  <p class="prose">Приём длится до тридцати минут. Осмотр уха, носа и горла, при необходимости — эндоскопия. Дальше разбираем, что происходит, и составляем план: что делать, чем лечить и зачем нужен каждый пункт.</p>
  <article class="card card-kids">
    <h3>Если приём у ребёнка</h3>
    <p>Ребёнок плачет на осмотре чаще не от боли, а от страха. Осмотр идёт в темпе ребёнка: сначала знакомство с инструментом, потом сам осмотр. Годовалый может перенести его спокойно, а десятилетний — испугаться, и это тоже нормально.</p>
  </article>
  <div class="shots">
    <div class="shot"><span class="ph-mark">кабинет</span><span class="ph-path">office/room.jpg</span></div>
    <div class="shot"><span class="ph-mark">оборудование</span><span class="ph-path">office/endoscope.jpg</span></div>
  </div>
</section>

<!-- ОТЗЫВЫ -->
<section class="sec" id="reviews">
  <p class="kicker center">Отзывы</p>
  <h2 class="sec-h center">Что говорят пациенты</h2>
  {reviews.pending && <p class="pending-flag">Образцы разметки. Настоящие отзывы переносятся из 2ГИС вручную.</p>}
  <div class="grid">
    {reviews.items.map((r) => (
      <blockquote class="card card-quote">
        {r.sample && <span class="sample-tag">образец</span>}
        <p>{r.text}</p>
        <cite>{r.name}<em>2ГИС</em></cite>
      </blockquote>
    ))}
  </div>
  <div class="center"><a class="link-out" href={contacts.dgis}>Все отзывы в 2ГИС →</a></div>
</section>

<!-- МАТЕРИАЛЫ -->
<section class="sec tint" id="guides">
  <p class="kicker">Материалы</p>
  <h2 class="sec-h">Полезное для пациентов</h2>
  <p class="sec-note">Готовятся к публикации. Выходят после проверки врачом.</p>
  <div class="grid">
    {guides.series.map((s) => (
      <article class="card">
        <h3>{s.title}</h3>
        <ul class="topics">{s.topics.map((t) => <li>{t}</li>)}</ul>
      </article>
    ))}
  </div>
</section>

<!-- FAQ -->
<section class="sec" id="faq">
  <p class="kicker center">Вопросы</p>
  <h2 class="sec-h center">Частые вопросы</h2>
  <div class="faq">
    {faq.items.map((f) => (
      <details>
        <summary><span>{f.q}</span></summary>
        {f.a && <p>{f.a}</p>}
        {f.pendingNote && <p class="pending-inline">{f.pendingNote}</p>}
      </details>
    ))}
  </div>
</section>

<!-- КОНТАКТЫ -->
<section class="sec cta-band" id="contacts">
  <h2 class="sec-h center light">Записаться на приём</h2>
  <p class="cta-sub">Напишите в WhatsApp — администратор подскажет ближайшие свободные окна.</p>
  <dl class="contacts">
    <dt>Адрес</dt><dd>{contacts.address}<br /><span class="muted">{contacts.city}</span></dd>
    <dt>Телефон</dt><dd><a href={contacts.phoneHref}>{contacts.phoneDisplay}</a></dd>
    <dt>Instagram</dt><dd><a href={contacts.instagram}>{contacts.instagramHandle}</a></dd>
  </dl>
  <div class="actions">
    <a class="btn btn-light" href={contacts.whatsapp}>Написать в WhatsApp</a>
    <a class="btn btn-outline-light" href={contacts.dgis}>Открыть в 2ГИС</a>
  </div>
</section>

<footer class="foot">
  <p>{contacts.doctorName} · {contacts.specialty} · {contacts.city}</p>
  <p class="muted">Информация на сайте не заменяет очную консультацию.</p>
</footer>

<a class="sticky-wa" href={contacts.whatsapp}>Написать в WhatsApp</a>

<style>
:root{
  --sans:'Manrope', system-ui, -apple-system, sans-serif;
  --navy:#10254A;
  --navy-dk:#0A1830;
  --blue:#2D63C8;
  --blue-dk:#1F4CA3;
  --ice:#EDF2FA;
  --ice-2:#DCE6F5;
  --ink:#16243D;
  --ink-soft:#5A6B85;
  --line:#D7E0EE;
  --gut:20px;
  --maxw:640px;
  --r:16px;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  margin:0; background:#fff; color:var(--ink);
  font-family:var(--sans); font-size:17px; line-height:1.55;
  padding-bottom:88px; overflow-x:hidden;
}
a{color:inherit}

/* ── первый экран ───────────────────────────────── */
.hero{
  background:linear-gradient(165deg, var(--navy) 0%, var(--navy-dk) 100%);
  color:#fff; padding:0 var(--gut) 28px;
  border-radius:0 0 26px 26px;
}
.hero > *{max-width:var(--maxw); margin-left:auto; margin-right:auto}
.nav{display:flex; align-items:center; justify-content:space-between; padding:14px 0 24px}
.brand{font-size:19px; font-weight:800; letter-spacing:-.02em}
.brand .dot{color:#6E9BEF}
.nav-call{
  display:inline-flex; align-items:center; min-height:44px; padding:0 4px;
  font-size:15px; font-weight:600; text-decoration:none; white-space:nowrap; color:#C8D9F5;
}
.eyebrow{
  margin:0 0 12px; font-size:12px; font-weight:700;
  letter-spacing:.14em; text-transform:uppercase; color:#7FA6EC;
}
h1{
  font-size:clamp(30px,7.8vw,44px); line-height:1.13; font-weight:800;
  letter-spacing:-.03em; margin:0 0 14px;
}
.hero .sub{font-size:17px; color:#BDD0EE; margin:0 0 24px; font-weight:400}

.hero-photo{
  aspect-ratio:4/3; border-radius:var(--r); margin:0 0 16px;
  background:
    repeating-linear-gradient(115deg, rgba(255,255,255,.05) 0 3px, transparent 3px 12px),
    rgba(255,255,255,.08);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.16);
  display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5px;
  text-align:center; padding:16px;
}
.ph-mark{font-size:13px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:#8FB3F2}
.ph-path{font-size:13px; color:#A8BFE2}
.ph-hint{font-size:13px; font-style:italic; color:#8296B5}

.hours-card{
  background:#fff; color:var(--ink); border-radius:var(--r);
  padding:18px 18px 16px; box-shadow:0 12px 32px rgba(8,22,48,.22);
}
.hours-card h2{font-size:16px; font-weight:800; margin:0 0 12px; letter-spacing:-.01em}
.hrow{
  display:flex; align-items:center; justify-content:space-between; gap:14px;
  padding:9px 0; border-bottom:1px solid var(--line); font-size:15px;
}
.hrow:last-of-type{border-bottom:0}
.hrow span{color:var(--ink-soft)}
.hrow b{font-weight:700; color:var(--blue-dk)}
.hours-note{margin:10px 0 0; font-size:13px; color:var(--ink-soft)}

/* ── действия ───────────────────────────────────── */
.actions{display:flex; flex-direction:column; gap:10px; margin:0 0 24px}
.btn{
  display:flex; align-items:center; justify-content:center; gap:10px;
  min-height:54px; padding:0 22px; border-radius:999px;
  text-decoration:none; font-size:16px; font-weight:700;
}
.btn.full{width:100%; margin-top:18px}
.btn-primary{background:var(--blue); color:#fff}
.btn-ghost{background:rgba(255,255,255,.12); color:#fff; box-shadow:inset 0 0 0 1px rgba(255,255,255,.28)}
.btn-light{background:#fff; color:var(--navy)}
.btn-outline-light{background:transparent; color:#fff; box-shadow:inset 0 0 0 1px rgba(255,255,255,.45)}
.call-ico{
  width:26px; height:26px; border-radius:50%; flex:0 0 auto;
  background:rgba(255,255,255,.22); position:relative;
}
.call-ico::after{
  content:''; position:absolute; inset:7px;
  border:2px solid #fff; border-radius:3px 8px 3px 8px;
}
.call-txt{display:flex; flex-direction:column; align-items:flex-start; line-height:1.2}
.call-txt em{font-style:normal; font-size:13px; font-weight:500; opacity:.8}
a:focus-visible,summary:focus-visible{outline:3px solid #6E9BEF; outline-offset:2px}

/* ── секции ─────────────────────────────────────── */
.sec{padding:44px var(--gut)}
.sec > *{max-width:var(--maxw); margin-left:auto; margin-right:auto}
.sec.tint{background:var(--ice)}
.kicker{
  margin:0 0 8px; font-size:12px; font-weight:800;
  letter-spacing:.15em; text-transform:uppercase; color:var(--blue);
}
.sec-h{
  font-size:clamp(23px,5.4vw,30px); line-height:1.2; font-weight:800;
  letter-spacing:-.025em; margin:0 0 16px;
}
.sec-h.light{color:#fff}
.center{text-align:center}
.sec-note{margin:-8px 0 18px; font-size:15px; color:var(--ink-soft)}
.prose{font-size:17px; line-height:1.62; margin:0 0 20px; color:var(--ink-soft)}
.line{
  margin:0; padding:14px 16px; border-radius:var(--r);
  background:var(--ice); font-size:15px; color:var(--ink);
  border-left:4px solid var(--blue);
}

/* ── статистика: только подтверждённые факты ────── */
.stat-row{display:grid; grid-template-columns:repeat(3,1fr); gap:9px; margin:0 0 20px}
.stat{
  background:#fff; border:1px solid var(--line); border-radius:var(--r);
  padding:14px 12px; text-align:center;
}
.stat-dark{background:var(--navy); border-color:var(--navy); color:#fff}
.stat b{display:block; font-size:20px; font-weight:800; letter-spacing:-.02em}
.stat span{display:block; font-size:12px; margin-top:4px; color:var(--ink-soft)}
.stat-dark span{color:#A8C0E6}

/* ── карточки ───────────────────────────────────── */
.grid{display:grid; grid-template-columns:1fr; gap:12px}
.card{
  background:#fff; border:1px solid var(--line); border-radius:var(--r);
  padding:20px 18px; margin:0;
}
.card h3{font-size:18px; font-weight:700; margin:0 0 6px; letter-spacing:-.015em}
.card p{margin:0; font-size:15px; color:var(--ink-soft)}
.card-ico{
  display:block; width:40px; height:40px; border-radius:11px; margin:0 0 14px;
  background:linear-gradient(150deg, var(--blue) 0%, var(--navy) 100%);
  position:relative;
}
.card-ico::after{
  content:''; position:absolute; left:50%; top:50%; width:15px; height:15px;
  transform:translate(-50%,-50%) rotate(45deg);
  border:2.5px solid #fff; border-left:0; border-top:0;
  border-radius:0 0 3px 0;
}
.card-band{
  height:78px; border-radius:11px; margin:0 0 13px;
  background:linear-gradient(140deg, var(--ice-2) 0%, var(--ice) 100%);
  display:flex; align-items:flex-end; padding:10px;
}
.band-tag{
  font-size:12px; font-weight:800; letter-spacing:.1em; text-transform:uppercase;
  background:var(--navy); color:#fff; padding:5px 10px; border-radius:999px;
}
.card-kids{background:linear-gradient(150deg,#fff 0%, var(--ice) 100%); margin-bottom:14px}
.shots{display:grid; grid-template-columns:1fr 1fr; gap:12px}
.shot{
  aspect-ratio:1; border-radius:var(--r); border:1px solid var(--line);
  background:var(--ice-2);
  display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px;
  text-align:center; padding:12px;
}
.shot .ph-mark{color:var(--blue-dk)}
.shot .ph-path{color:var(--ink-soft)}

.checks{list-style:none; margin:0; padding:0; display:grid; gap:9px}
.checks li{
  position:relative; padding:11px 14px 11px 40px; font-size:15px;
  background:#fff; border:1px solid var(--line); border-radius:11px;
}
.checks li::before{
  content:''; position:absolute; left:15px; top:16px; width:11px; height:7px;
  border:2px solid var(--blue); border-right:0; border-top:0;
  transform:rotate(-45deg);
}

/* ── цены ───────────────────────────────────────── */
.price-card{background:#fff; border:1px solid var(--line); border-radius:20px; padding:22px 18px}
.price-head{
  margin:0 0 10px; font-size:12px; font-weight:800;
  letter-spacing:.13em; text-transform:uppercase; color:var(--blue);
}
.price-head.mt{margin-top:24px}
.prow{
  display:flex; align-items:baseline; justify-content:space-between; gap:14px;
  padding:13px 0; border-bottom:1px solid var(--line);
}
.pname{display:flex; flex-direction:column; font-size:16px}
.pname em{font-style:normal; font-size:13px; color:var(--ink-soft); margin-top:2px}
.pval{font-size:19px; font-weight:800; white-space:nowrap; font-variant-numeric:tabular-nums; color:var(--navy)}
.micro{margin:14px 0 0; font-size:13px; color:var(--ink-soft)}

/* ── отзывы ─────────────────────────────────────── */
.pending-flag{
  margin:-8px 0 18px; padding:11px 14px; border-radius:11px; font-size:14px;
  background:#fff; border:1px dashed var(--blue); color:var(--blue-dk);
}
.card-quote p{font-size:16px; color:var(--ink); margin:0 0 12px}
.card-quote cite{
  font-style:normal; font-size:14px; font-weight:700;
  display:flex; flex-direction:column;
}
.card-quote cite em{font-style:normal; font-weight:500; font-size:12px; color:var(--ink-soft); margin-top:2px}
.sample-tag{
  display:inline-block; font-size:11px; font-weight:800; letter-spacing:.12em;
  text-transform:uppercase; color:var(--blue); margin:0 0 9px;
}
.link-out{
  display:inline-flex; align-items:center; min-height:44px; margin-top:8px;
  font-size:15px; font-weight:700; color:var(--blue); text-decoration:none;
}

/* ── материалы / faq ────────────────────────────── */
.topics{list-style:none; margin:10px 0 0; padding:0}
.topics li{padding:9px 0; border-bottom:1px solid var(--line); font-size:15px; color:var(--ink-soft)}
.topics li:last-child{border-bottom:0}
.faq details{background:#fff; border:1px solid var(--line); border-radius:12px; margin:0 0 9px}
.faq summary{
  cursor:pointer; padding:16px 18px; font-size:16px; font-weight:600; list-style:none;
  display:flex; align-items:flex-start; gap:12px; min-height:44px;
}
.faq summary::-webkit-details-marker{display:none}
.faq summary::before{content:'+'; color:var(--blue); font-weight:800; flex:0 0 auto}
.faq details[open] summary::before{content:'–'}
.faq p{margin:0 0 16px; padding:0 18px 0 42px; font-size:15px; color:var(--ink-soft)}
.pending-inline{font-style:italic; color:var(--blue-dk)}

/* ── нижний призыв ──────────────────────────────── */
.cta-band{
  background:linear-gradient(165deg, var(--navy) 0%, var(--navy-dk) 100%);
  color:#fff; border-radius:26px 26px 0 0;
}
.cta-sub{margin:0 0 22px; font-size:16px; color:#BDD0EE; text-align:center}
.contacts{margin:0 0 22px; display:grid; grid-template-columns:auto 1fr; gap:12px 18px}
.contacts dt{font-size:12px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; color:#7FA6EC; padding-top:4px}
.contacts dd{margin:0; font-size:16px}
.contacts dd a{display:inline-flex; align-items:center; min-height:44px}
.cta-band .muted{color:#A8C0E6}
.foot{
  background:var(--navy-dk); color:#A8C0E6;
  padding:24px var(--gut) 32px; font-size:14px;
}
.foot p{margin:0 0 5px; max-width:var(--maxw); margin-left:auto; margin-right:auto}
.foot .muted{color:#7A90B2}

/* ── закреплённая кнопка ────────────────────────── */
.sticky-wa{
  position:fixed; left:14px; right:14px; bottom:14px; z-index:30;
  display:flex; align-items:center; justify-content:center;
  min-height:56px; border-radius:999px; background:var(--blue); color:#fff;
  text-decoration:none; font-size:16px; font-weight:700;
  box-shadow:0 10px 28px rgba(16,37,74,.4);
}

/* ── десктоп ────────────────────────────────────── */
@media (min-width:768px){
  :root{--gut:40px; --maxw:1000px}
  body{font-size:18px; padding-bottom:0}
  .hero{padding-bottom:48px; border-radius:0 0 40px 40px; position:relative}
