---
import { contacts, services, guides, reviews, faq, prices, byGroup, hero, about } from '../../lib/site.js';
---

<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{contacts.doctorName} — ЛОР-врач в Астане · Вариант F</title>
<meta name="description" content={hero.subtitle} />
<meta name="robots" content="noindex" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Oranienbaum&family=Onest:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body>

<!-- ПЕРВЫЙ ЭКРАН: кадр кабинета под тёмной заливкой -->
<header class="hero">
  <nav class="nav">
    <span class="brand">Lor<span class="dot">.</span>roza</span>
    <a class="nav-call" href={contacts.phoneHref}>{contacts.phoneDisplay}</a>
  </nav>

  <div class="hero-plate">
    <span class="ph-mark">фото кабинета или врача</span>
    <span class="ph-path">office/room.jpg</span>
    <span class="ph-hint">широкий горизонтальный кадр</span>
  </div>

  <div class="hero-text">
    <p class="rule-label"><span class="rule"></span>Астана · с 2020 года</p>
    <h1>Уши, горло<br />и нос —<br />без лишнего</h1>
    <p class="sub">{hero.subtitle}</p>
    <div class="actions">
      <a class="btn btn-solid" href={contacts.whatsapp}>Написать в WhatsApp</a>
      <a class="btn btn-line" href={contacts.whatsappBooking}>Записаться на приём</a>
    </div>
  </div>
</header>

<!-- ЗАЯВЛЕНИЕ -->
<section class="sec cream" id="about">
  <p class="kicker">О враче</p>
  <h2 class="display">{hero.title}</h2>
  <p class="lede">{hero.line}</p>
  <div class="split">
    <div class="split-plate">
      <span class="ph-mark">портрет врача</span>
      <span class="ph-path">doctor/portrait.jpg</span>
      <span class="ph-hint">вертикальный</span>
    </div>
    <div class="split-body">
      <p class="prose">{about}</p>
      <p class="sig">{contacts.doctorName}<em>врач-оториноларинголог</em></p>
    </div>
  </div>
</section>

<!-- ПОЧЕМУ ВЫБИРАЮТ — ряд с тонкими разделителями -->
<section class="sec cream tight" id="why">
  <p class="kicker center">Принципы</p>
  <h2 class="display center">Почему выбирают</h2>
  <div class="pillars">
    {services.whyMe.map((w, i) => (
      <article class="pillar">
        <span class="pillar-no">{String(i + 1).padStart(2, '0')}</span>
        <h3>{w.title}</h3>
        <p>{w.text}</p>
      </article>
    ))}
  </div>
</section>

<!-- ТЁМНАЯ ПОЛОСА С ГАЛЕРЕЕЙ -->
<section class="sec dark" id="visit">
  <p class="kicker light center">Приём</p>
  <h2 class="display light center">Как проходит приём</h2>
  <p class="lede light center">Приём длится до тридцати минут. Осмотр уха, носа и горла, при необходимости — эндоскопия. Дальше разбираем, что происходит, и составляем план.</p>
  <div class="strip">
    <div class="strip-plate"><span class="ph-mark">кабинет</span><span class="ph-path">office/room.jpg</span></div>
    <div class="strip-plate"><span class="ph-mark">оборудование</span><span class="ph-path">office/endoscope.jpg</span></div>
    <div class="strip-plate"><span class="ph-mark">врач за работой</span><span class="ph-path">doctor/work.jpg</span></div>
    <div class="strip-plate"><span class="ph-mark">эндоскоп</span><span class="ph-path">office/scope.jpg</span></div>
  </div>
  <div class="kids-note">
    <h3>Если приём у ребёнка</h3>
    <p>Ребёнок плачет на осмотре чаще не от боли, а от страха. Осмотр идёт в темпе ребёнка: сначала знакомство с инструментом, потом сам осмотр. Годовалый может перенести его спокойно, а десятилетний — испугаться, и это тоже нормально.</p>
  </div>
</section>

<!-- С ЧЕМ ОБРАЩАЮТСЯ -->
<section class="sec cream" id="complaints">
  <p class="kicker">Направления</p>
  <h2 class="display">С чем обращаются</h2>
  <ul class="entries">
    {services.complaints.map((c) => (
      <li>
        <span class="entry-tag">{c.region}</span>
        <h3>{c.title}</h3>
        <p>{c.note}</p>
      </li>
    ))}
  </ul>
</section>

<!-- ЧТО ВХОДИТ -->
<section class="sec cream tight" id="services">
  <p class="kicker">Консультация</p>
  <h2 class="display">Что входит в приём</h2>
  <ul class="checks">
    {services.consultationIncludes.map((s) => <li>{s}</li>)}
  </ul>
</section>

<!-- ЦЕНЫ -->
<section class="sec sand" id="prices">
  <p class="kicker center">Прайс</p>
  <h2 class="display center">Услуги и цены</h2>
  <div class="price-list">
    <p class="price-head">Приём</p>
    {byGroup('приём').map((p) => (
      <div class="prow">
        <span class="pname">{p.title}{p.meta && <em>{p.meta}</em>}</span>
        <span class="pval">{p.amount}&thinsp;{p.currency}</span>
      </div>
    ))}
    <p class="price-head mt">Манипуляции</p>
    {byGroup('манипуляции').map((p) => (
      <div class="prow">
        <span class="pname">{p.title}{p.meta && <em>{p.meta}</em>}</span>
        <span class="pval">{p.amount}&thinsp;{p.currency}</span>
      </div>
    ))}
  </div>
  <p class="micro center">{prices.note}</p>
</section>

<!-- ОТЗЫВЫ -->
<section class="sec cream" id="reviews">
  <p class="kicker center">Отзывы</p>
  <h2 class="display center">Что говорят пациенты</h2>
  {reviews.pending && <p class="pending-flag">Образцы разметки. Настоящие отзывы переносятся из 2ГИС вручную.</p>}
  <div class="quotes">
    {reviews.items.map((r) => (
      <blockquote class="quote">
        {r.sample && <span class="sample-tag">образец</span>}
        <p>{r.text}</p>
        <cite>{r.name}<em>2ГИС</em></cite>
      </blockquote>
    ))}
  </div>
  <div class="center"><a class="link-out" href={contacts.dgis}><span>Все отзывы в 2ГИС</span></a></div>
</section>

<!-- МАТЕРИАЛЫ -->
<section class="sec cream tight" id="guides">
  <p class="kicker">Материалы</p>
  <h2 class="display">Полезное для пациентов</h2>
  <p class="sec-note">Готовятся к публикации. Выходят после проверки врачом.</p>
  {guides.series.map((s) => (
    <div class="guide">
      <p class="rule-label"><span class="rule"></span>{s.title}</p>
      <ul class="topics">{s.topics.map((t) => <li>{t}</li>)}</ul>
    </div>
  ))}
</section>

<!-- FAQ -->
<section class="sec sand" id="faq">
  <p class="kicker center">Вопросы</p>
  <h2 class="display center">Частые вопросы</h2>
  <div class="faq">
    {faq.items.map((f) => (
      <details>
        <summary><span>{f.q}</span></summary>
        {f.a && <p>{f.a}</p>}
        {f.pendingNote && <p class="pending-inline">{f.pendingNote}</p>}
      </details>
    ))}
  </div>
</section>

<!-- КОНТАКТЫ -->
<section class="sec dark" id="contacts">
  <p class="kicker light center">Запись</p>
  <h2 class="display light center">Записаться на приём</h2>
  <p class="lede light center">Напишите в WhatsApp — администратор подскажет ближайшие свободные окна.</p>
  <dl class="contacts">
    <dt>Адрес</dt><dd>{contacts.address}<br /><span class="muted">{contacts.city}</span></dd>
    <dt>Телефон</dt><dd><a href={contacts.phoneHref}>{contacts.phoneDisplay}</a></dd>
    <dt>Instagram</dt><dd><a href={contacts.instagram}>{contacts.instagramHandle}</a></dd>
  </dl>
  <div class="actions center-actions">
    <a class="btn btn-solid" href={contacts.whatsapp}>Написать в WhatsApp</a>
    <a class="btn btn-line-light" href={contacts.dgis}>Открыть в 2ГИС</a>
  </div>
</section>

<footer class="foot">
  <p>{contacts.doctorName} · {contacts.specialty} · {contacts.city}</p>
  <p class="muted">Информация на сайте не заменяет очную консультацию.</p>
</footer>

<a class="sticky-wa" href={contacts.whatsapp}>Написать в WhatsApp</a>

<style>
:root{
  --cream:#F4EFE7;
  --sand:#E9E1D4;
  --dark:#221D18;
  --dark-2:#2E2720;
  --ink:#231E19;
  --ink-soft:#6E6358;
  --gold:#A8875C;
  --gold-lt:#C4A97E;
  --line:rgba(35,30,25,.14);
  --display:'Oranienbaum', Georgia, serif;
  --sans:'Onest', system-ui, sans-serif;
  --gut:20px;
  --maxw:660px;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  margin:0; background:var(--cream); color:var(--ink);
  font-family:var(--sans); font-size:17px; line-height:1.6; font-weight:300;
  padding-bottom:88px; overflow-x:hidden;
}
a{color:inherit}

/* ── первый экран ───────────────────────────────── */
.hero{background:var(--dark); color:var(--cream); padding:0 0 40px}
.nav{
  display:flex; align-items:center; justify-content:space-between;
  padding:14px var(--gut); max-width:var(--maxw); margin:0 auto;
}
.brand{font-family:var(--display); font-size:22px; letter-spacing:.02em}
.brand .dot{color:var(--gold-lt)}
.nav-call{
  display:inline-flex; align-items:center; min-height:44px;
  font-size:14px; letter-spacing:.04em; text-decoration:none; color:var(--gold-lt); white-space:nowrap;
}
.hero-plate{
  aspect-ratio:4/3; margin:0 0 30px;
  background:
    repeating-linear-gradient(118deg, rgba(244,239,231,.05) 0 3px, transparent 3px 14px),
    #191411;
  display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px;
  text-align:center; padding:18px;
}
.ph-mark{
  font-size:12px; letter-spacing:.2em; text-transform:uppercase;
  color:var(--gold-lt); font-weight:500;
}
.ph-path{font-size:13px; color:#9A8D7E}
.ph-hint{font-size:13px; font-style:italic; color:#7E7263}
.hero-text{padding:0 var(--gut); max-width:var(--maxw); margin:0 auto}
.rule-label{
  display:flex; align-items:center; gap:12px; margin:0 0 18px;
  font-size:12px; letter-spacing:.22em; text-transform:uppercase; color:var(--gold);
}
.rule{width:34px; height:1px; background:var(--gold); flex:0 0 auto}
h1{
  font-family:var(--display); font-weight:400;
  font-size:clamp(46px,13vw,76px); line-height:1.0; letter-spacing:.005em;
  margin:0 0 20px;
}
.hero .sub{font-size:17px; color:#BFB3A3; margin:0 0 28px; max-width:34ch}

/* ── действия ───────────────────────────────────── */
.actions{display:flex; flex-direction:column; gap:11px}
.btn{
  display:flex; align-items:center; justify-content:center;
  min-height:54px; padding:0 26px; text-decoration:none;
  font-size:13px; letter-spacing:.17em; text-transform:uppercase; font-weight:500;
}
.btn-solid{background:var(--gold); color:#1C1713}
.btn-line{background:transparent; color:var(--cream); box-shadow:inset 0 0 0 1px rgba(244,239,231,.4)}
.btn-line-light{background:transparent; color:var(--cream); box-shadow:inset 0 0 0 1px rgba(244,239,231,.4)}
a:focus-visible,summary:focus-visible{outline:2px solid var(--gold); outline-offset:3px}

/* ── секции ─────────────────────────────────────── */
.sec{padding:52px var(--gut)}
.sec > *{max-width:var(--maxw); margin-left:auto; margin-right:auto}
.sec.tight{padding-top:8px}
.cream{background:var(--cream)}
.sand{background:var(--sand)}
.dark{background:var(--dark); color:var(--cream)}
.kicker{
  margin:0 0 14px; font-size:12px; letter-spacing:.22em;
  text-transform:uppercase; color:var(--gold); font-weight:500;
}
.kicker.light{color:var(--gold-lt)}
.display{
  font-family:var(--display); font-weight:400;
  font-size:clamp(30px,7.4vw,44px); line-height:1.08; letter-spacing:.005em;
  margin:0 0 18px;
}
.display.light{color:var(--cream)}
.center{text-align:center}
.lede{font-size:18px; color:var(--ink-soft); margin:0 0 26px; max-width:44ch}
.lede.light{color:#BFB3A3}
.lede.center{margin-left:auto; margin-right:auto}
.prose{font-size:16px; margin:0 0 18px; color:var(--ink-soft)}
.sec-note{margin:-8px 0 22px; font-size:15px; color:var(--ink-soft); font-style:italic}

/* ── о враче ────────────────────────────────────── */
.split{display:grid; grid-template-columns:1fr; gap:22px}
.split-plate{
  aspect-ratio:3/4;
  background:
    repeating-linear-gradient(118deg, rgba(35,30,25,.05) 0 3px, transparent 3px 14px),
    var(--sand);
  display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px;
  text-align:center; padding:16px;
}
.split-plate .ph-mark{color:var(--gold)}
.split-plate .ph-path,.split-plate .ph-hint{color:var(--ink-soft)}
.sig{
  margin:0; font-family:var(--display); font-size:21px; line-height:1.3;
  padding-top:16px; border-top:1px solid var(--line);
}
.sig em{
  display:block; font-family:var(--sans); font-style:normal;
  font-size:12px; letter-spacing:.18em; text-transform:uppercase;
  color:var(--gold); margin-top:7px;
}

/* ── принципы ───────────────────────────────────── */
.pillars{display:grid; grid-template-columns:1fr; gap:0}
.pillar{padding:22px 0; border-top:1px solid var(--line)}
.pillar:last-child{border-bottom:1px solid var(--line)}
.pillar-no{
  display:block; font-size:12px; letter-spacing:.2em; color:var(--gold); margin:0 0 9px;
}
.pillar h3{font-family:var(--display); font-weight:400; font-size:24px; margin:0 0 8px; letter-spacing:.005em}
.pillar p{margin:0; font-size:15px; color:var(--ink-soft)}

/* ── тёмная полоса ──────────────────────────────── */
.strip{display:grid; grid-template-columns:1fr 1fr; gap:10px; margin:0 0 30px}
.strip-plate{
  aspect-ratio:3/4;
  background:
    repeating-linear-gradient(118deg, rgba(244,239,231,.05) 0 3px, transparent 3px 14px),
    #191411;
  display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5px;
  text-align:center; padding:12px;
}
.kids-note{border-top:1px solid rgba(244,239,231,.22); padding-top:22px}
.kids-note h3{font-family:var(--display); font-weight:400; font-size:25px; margin:0 0 10px}
.kids-note p{margin:0; font-size:15px; color:#BFB3A3}

/* ── направления ────────────────────────────────── */
.entries{list-style:none; margin:0; padding:0}
.entries li{padding:20px 0; border-top:1px solid var(--line)}
.entries li:last-child{border-bottom:1px solid var(--line)}
.entry-tag{
  display:inline-block; font-size:11px; letter-spacing:.2em; text-transform:uppercase;
  color:var(--gold); margin:0 0 8px;
}
.entries h3{font-family:var(--display); font-weight:400; font-size:24px; margin:0 0 6px}
.entries p{margin:0; font-size:15px; color:var(--ink-soft)}

/* ── перечень ───────────────────────────────────── */
.checks{list-style:none; margin:0; padding:0}
.checks li{
  padding:12px 0 12px 26px; border-bottom:1px solid var(--line);
  font-size:16px; position:relative;
}
.checks li::before{
  content:''; position:absolute; left:2px; top:20px;
  width:10px; height:1px; background:var(--gold);
}

/* ── цены ───────────────────────────────────────── */
.price-list{border-top:1px solid var(--line)}
.price-head{
  margin:22px 0 4px; font-size:12px; letter-spacing:.2em;
  text-transform:uppercase; color:var(--gold);
}
.price-head.mt{margin-top:34px}
.prow{
  display:flex; align-items:baseline; justify-content:space-between; gap:16px;
  padding:14px 0; border-bottom:1px solid var(--line);
}
.pname{display:flex; flex-direction:column; font-size:16px}
.pname em{font-style:normal; font-size:13px; color:var(--ink-soft); margin-top:3px}
.pval{
  font-family:var(--display); font-size:26px; white-space:nowrap;
  font-variant-numeric:tabular-nums; letter-spacing:.01em;
}
.micro{margin:18px 0 0; font-size:13px; color:var(--ink-soft); font-style:italic}

/* ── отзывы ─────────────────────────────────────── */
.pending-flag{
  margin:-6px 0 24px; padding:11px 14px; font-size:13px;
  border:1px solid var(--gold); color:var(--gold);
  letter-spacing:.02em;
}
.quotes{display:grid; gap:0}
.quote{margin:0; padding:24px 0; border-top:1px solid var(--line)}
.quote:last-child{border-bottom:1px solid var(--line)}
.quote p{
  margin:0 0 14px; font-family:var(--display); font-weight:400;
  font-size:21px; line-height:1.4;
}
.quote cite{font-style:normal; display:flex; flex-direction:column; font-size:14px}
.quote cite em{
  font-style:normal; font-size:11px; letter-spacing:.18em; text-transform:uppercase;
  color:var(--gold); margin-top:4px;
}
.sample-tag{
  display:inline-block; font-size:11px; letter-spacing:.2em; text-transform:uppercase;
  color:var(--gold); margin:0 0 10px;
}
.link-out{
  display:inline-flex; align-items:center; min-height:44px; margin-top:16px;
  font-size:12px; letter-spacing:.2em; text-transform:uppercase; color:var(--gold);
  text-decoration:none; font-weight:500;
}
.link-out span{border-bottom:1px solid currentColor; padding-bottom:3px}

/* ── материалы / faq ────────────────────────────── */
.guide{margin:0 0 30px}
.topics{list-style:none; margin:0; padding:0}
.topics li{padding:11px 0; border-bottom:1px solid var(--line); font-size:16px; color:var(--ink-soft)}
.faq details{border-bottom:1px solid var(--line)}
.faq summary{
  cursor:pointer; padding:18px 0; font-size:17px; list-style:none;
  display:flex; align-items:flex-start; gap:14px; min-height:44px;
}
.faq summary::-webkit-details-marker{display:none}
.faq summary::before{content:'+'; color:var(--gold); flex:0 0 auto; line-height:1.4}
.faq details[open] summary::before{content:'–'}
.faq p{margin:0 0 18px; padding-left:28px; font-size:15px; color:var(--ink-soft)}
.pending-inline{font-style:italic; color:var(--gold)}

/* ── контакты / подвал ──────────────────────────── */
.contacts{margin:0 0 26px; display:grid; grid-template-columns:auto 1fr; gap:14px 20px}
.contacts dt{font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:var(--gold-lt); padding-top:5px}
.contacts dd{margin:0; font-size:16px}
.contacts dd a{display:inline-flex; align-items:center; min-height:44px}
.dark .muted{color:#9A8D7E}
.foot{
  background:#191411; color:#9A8D7E; padding:26px var(--gut) 34px; font-size:13px;
}
.foot p{margin:0 0 5px; max-width:var(--maxw); margin-left:auto; margin-right:auto}

/* ── закреплённая кнопка ────────────────────────── */
.sticky-wa{
  position:fixed; left:14px; right:14px; bottom:14px; z-index:30;
  display:flex; align-items:center; justify-content:center;
  min-height:56px; background:var(--gold); color:#1C1713; text-decoration:none;
  font-size:13px; letter-spacing:.17em; text-transform:uppercase; font-weight:500;
  box-shadow:0 10px 30px rgba(25,20,17,.4);
}

/* ── десктоп ────────────────────────────────────── */
@media (min-width:768px){
  :root{--gut:44px; --maxw:1020px}
  body{font-size:18px; padding-bottom:0}
  .hero{padding-bottom:64px}
  .hero-plate{aspect-ratio:21/9; margin-bottom:44px}
  h1{font-size:clamp(64px,7vw,92px)}
  .hero .sub{font-size:19px}
  .actions{flex-direction:row}
  .center-actions{justify-content:center}
  .btn{flex:0 0 auto; min-width:260px}
  .sec{padding:80px var(--gut)}
  .split{grid-template-columns:320px 1fr; gap:40px; align-items:center}
  .pillars{grid-template-columns:1fr 1fr; gap:0 40px}
  .strip{grid-template-columns:repeat(4,1fr); gap:12px}
  .entries{columns:2; column-gap:44px}
  .entries li{break-inside:avoid}
  .checks{columns:2; column-gap:44px}
  .checks li{break-inside:avoid}
  .quotes{grid-template-columns:1fr 1fr; gap:0 44px}
  .price-list{max-width:760px}
  .display{font-size:clamp(38px,4.2vw,52px)}
  .sticky-wa{display:none}
}
@media (prefers-reduced-motion:no-preference){
  .btn{transition:opacity .18s ease}
  .btn:hover{opacity:.85}
}
</style>
</body>
</html>
